@using Gprojet.Backend.Contracts.Commun
@using Gprojet.Front.Components
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Gprojet.Front.Api.BffApiClient Bff
@inject IStringLocalizer<Textes> T

<a class="skip-link" href="#contenu">@T["Evitement"]</a>
<div dir="@Dir" class="page @(_replie ? "sidebar-collapsed" : null) @(_mobileOuvert ? "mobile-open" : null)">
    <aside class="sidebar" id="menu-principal">
        <div class="sidebar-brand">
            <img src="images/logo_hcp.png" alt="" height="28" />
            <span class="brand-text">@T["Marque"]</span>
        </div>
        <nav class="sidebar-nav" aria-label="@T["NavPrincipale"]" @onclick="FermerMobile">
            <NavigationItem Href="" Icone="fa-house" Libelle="@T["NavAccueil"]" Match="NavLinkMatch.All" />
            <div class="nav-section-label">@T["SectionTravail"]</div>
            <NavigationItem Href="taches" Icone="fa-list-check" Libelle="@T["NavTaches"]" />
            <NavigationItem Href="projets" Icone="fa-diagram-project" Libelle="@T["NavProjets"]" />
            <NavigationItem Href="temps" Icone="fa-clock" Libelle="@T["NavTemps"]" />
            <div class="nav-section-label">@T["SectionPilotage"]</div>
            <NavigationItem Href="reporting" Icone="fa-chart-line" Libelle="@T["NavReporting"]" />
            <AuthorizeView Policy="@RolesApplication.PolitiquePortefeuilleDirection">
                <NavigationItem Href="portefeuille" Icone="fa-building-columns" Libelle="@T["NavPortefeuille"]" />
            </AuthorizeView>
            <AuthorizeView Policy="@RolesApplication.PolitiqueAdministration">
                <div class="nav-section-label">@T["SectionOrganisation"]</div>
                <NavigationItem Href="administration" Icone="fa-gear" Libelle="@T["NavAdministration"]" />
            </AuthorizeView>
        </nav>
        <div class="sidebar-footer">
            <div class="user-row">
                <span class="user-avatar" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                <AuthorizeView>
                    <Authorized>
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <button type="button" class="topbar-btn" aria-label="@T["SeDeconnecter"]" title="@T["SeDeconnecter"]" @onclick="DeconnecterAsync">
                            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a class="user-name" href="connexion">@T["SeConnecter"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </aside>
    <div class="main-area">
        <header class="topbar">
            <button type="button" class="topbar-btn" aria-label="@T["BasculerMenu"]"
                    aria-controls="menu-principal" aria-expanded="@(!_replie ? "true" : "false")" @onclick="Basculer">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
            <nav class="breadcrumb-nav" aria-label="@T["FilAriane"]"><span class="current">@T["Marque"]</span></nav>
            <div class="search-box" role="search">
                <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
                <input id="recherche-globale" type="search" placeholder="@T["Rechercher"]" aria-label="@T["RechercherAria"]" aria-keyshortcuts="Control+K" />
                <span class="search-shortcut" aria-hidden="true">Ctrl+K</span>
            </div>
            <button type="button" class="topbar-btn" aria-label="@T["Notifications"]">
                <i class="fa-regular fa-bell" aria-hidden="true"></i>
            </button>
            <SelecteurLangue />
        </header>
        <main class="content-area" id="contenu" tabindex="-1">
            <div class="animate-in" @key="CleRoute">@Body</div>
        </main>
        <IndicateurChargement />
        <Snackbar />
    </div>
</div>

@code {
    // Une cle par route (sans requete ni ancre) : l'apparition ne rejoue qu'a la navigation.
    private string CleRoute => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    // dir sur la racine du layout (testable) ; <html dir> est posé au démarrage par layout.js d'après le cookie de langue.
    private static string Dir => System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";

    private bool _replie;
    private bool _mobileOuvert;

    // shortcut: un seul bouton pilote deux états (replié en bureau, ouvert en mobile) ; aria-expanded suit le mode bureau. Passer à matchMedia si besoin d'exactitude.
    private void Basculer()
    {
        _replie = !_replie;
        _mobileOuvert = !_mobileOuvert;
    }

    // Rechargement complet : l'état d'authentification (mis en cache) repart de /bff/user.
    private async Task DeconnecterAsync()
    {
        await Bff.DeconnecterAsync();
        Navigation.NavigateTo("connexion", forceLoad: true);
    }

    private void FermerMobile() => _mobileOuvert = false;
}
