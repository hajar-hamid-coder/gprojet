@using Gprojet.Backend.Contracts.Commun
@using Gprojet.Front.Components
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Gprojet.Front.Api.BffApiClient Bff

<a class="skip-link" href="#contenu">Aller au contenu</a>
<div class="page @(_replie ? "sidebar-collapsed" : null) @(_mobileOuvert ? "mobile-open" : null)">
    <aside class="sidebar" id="menu-principal">
        <div class="sidebar-brand">
            <img src="images/logo_hcp.png" alt="" height="28" />
            <span class="brand-text">GestionProjet</span>
        </div>
        <nav class="sidebar-nav" aria-label="Navigation principale" @onclick="FermerMobile">
            <NavigationItem Href="" Icone="fa-house" Libelle="Accueil" Match="NavLinkMatch.All" />
            <div class="nav-section-label">Travail</div>
            <NavigationItem Href="taches" Icone="fa-list-check" Libelle="Mes tâches" />
            <NavigationItem Href="projets" Icone="fa-diagram-project" Libelle="Projets" />
            <NavigationItem Href="temps" Icone="fa-clock" Libelle="Temps" />
            <div class="nav-section-label">Pilotage</div>
            <NavigationItem Href="reporting" Icone="fa-chart-line" Libelle="Reporting" />
            <AuthorizeView Policy="@RolesApplication.PolitiquePortefeuilleDirection">
                <NavigationItem Href="portefeuille" Icone="fa-building-columns" Libelle="Portefeuille direction" />
            </AuthorizeView>
            <AuthorizeView Policy="@RolesApplication.PolitiqueAdministration">
                <div class="nav-section-label">Organisation</div>
                <NavigationItem Href="administration" Icone="fa-gear" Libelle="Administration" />
            </AuthorizeView>
        </nav>
        <div class="sidebar-footer">
            <div class="user-row">
                <span class="user-avatar" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                <AuthorizeView>
                    <Authorized>
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <button type="button" class="topbar-btn" aria-label="Se déconnecter" title="Se déconnecter" @onclick="DeconnecterAsync">
                            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a class="user-name" href="connexion">Se connecter</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </aside>
    <div class="main-area">
        <header class="topbar">
            <button type="button" class="topbar-btn" aria-label="Replier ou déplier le menu"
                    aria-controls="menu-principal" aria-expanded="@(!_replie ? "true" : "false")" @onclick="Basculer">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
            <nav class="breadcrumb-nav" aria-label="Fil d'Ariane"><span class="current">GestionProjet</span></nav>
            <div class="search-box" role="search">
                <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
                <input id="recherche-globale" type="search" placeholder="Rechercher…" aria-label="Rechercher" aria-keyshortcuts="Control+K" />
                <span class="search-shortcut" aria-hidden="true">Ctrl+K</span>
            </div>
            <button type="button" class="topbar-btn" aria-label="Notifications">
                <i class="fa-regular fa-bell" aria-hidden="true"></i>
            </button>
        </header>
        <main class="content-area" id="contenu" tabindex="-1">
            <div class="animate-in" @key="CleRoute">@Body</div>
        </main>
        <IndicateurChargement />
        <Snackbar />
    </div>
</div>

@code {
    // Une cle par route (sans requete ni ancre) : l'apparition ne rejoue qu'a la navigation.
    private string CleRoute => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    private bool _replie;
    private bool _mobileOuvert;

    // shortcut: un seul bouton pilote deux états (replié en bureau, ouvert en mobile) ; aria-expanded suit le mode bureau. Passer à matchMedia si besoin d'exactitude.
    private void Basculer()
    {
        _replie = !_replie;
        _mobileOuvert = !_mobileOuvert;
    }

    // Rechargement complet : l'état d'authentification (mis en cache) repart de /bff/user.
    private async Task DeconnecterAsync()
    {
        await Bff.DeconnecterAsync();
        Navigation.NavigateTo("connexion", forceLoad: true);
    }

    private void FermerMobile() => _mobileOuvert = false;
}
