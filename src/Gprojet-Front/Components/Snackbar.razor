@using Gprojet.Front.Services
@implements IDisposable
@inject NotificationUiService Notifications
@inject IStringLocalizer<Textes> T

<div class="snackbar-zone">
    @foreach (var n in Notifications.Messages)
    {
        <div class="snackbar @(n.Type == TypeNotification.Erreur ? "message-erreur" : n.Type == TypeNotification.Succes ? "message-succes" : "snackbar-info") animate-in"
             role="@(n.Type == TypeNotification.Erreur ? "alert" : "status")" @key="n.Id">
            <span>@n.Message</span>
            <button type="button" class="topbar-btn" aria-label="@T["FermerNotification"]" @onclick="() => Notifications.Fermer(n.Id)">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Notifications.Changed += Rafraichir;

    private void Rafraichir() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Notifications.Changed -= Rafraichir;
}
