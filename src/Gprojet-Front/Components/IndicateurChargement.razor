@using Gprojet.Front.Services
@implements IDisposable
@inject ChargementService Chargement
@inject IStringLocalizer<Textes> T

@if (Chargement.EnCours)
{
    <div class="chargement-global" role="status">
        <span class="spinner" aria-hidden="true"></span>
        <span class="sr-only">@T["ChargementEnCours"]</span>
    </div>
}

@code {
    protected override void OnInitialized() => Chargement.Changed += Rafraichir;

    private void Rafraichir() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Chargement.Changed -= Rafraichir;
}
