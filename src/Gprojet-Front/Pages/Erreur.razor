@page "/erreur"
@inject IStringLocalizer<Textes> T

<PageTitle>@T["ErreurTitre"]</PageTitle>
<div class="empty-state" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <h1>@T["ErreurTitre"]</h1>
    <p class="desc">@T["ErreurTexte"]</p>
    <p class="desc">@T["IdentifiantCorrelation"]</p>
    <code class="identifiant-correlation">@_identifiant</code>
    <a class="toolbar-btn primary" href="">@T["RetourAccueil"]</a>
</div>

@code {
    /// <summary>Identifiant de corrélation fourni par l'appelant ; à défaut, généré à l'affichage. Jamais de détail technique.</summary>
    [Parameter] public string? Identifiant { get; set; }

    // shortcut: le serveur ne renvoie pas encore d'identifiant d'erreur ; remplacer le Guid local par celui du journal serveur quand il existera.
    private string _identifiant = "";

    protected override void OnInitialized() => _identifiant = Identifiant ?? Guid.NewGuid().ToString();
}
