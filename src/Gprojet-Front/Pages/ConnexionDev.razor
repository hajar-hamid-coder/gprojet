@page "/connexion"
@layout Layouts.LayoutVide
@using Gprojet.Front.Api
@inject BffApiClient Bff
@inject IStringLocalizer<Textes> T

<PageTitle>@T["ConnexionTitre"]</PageTitle>
<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <img src="images/logo_hcp.png" alt="" height="36" />
            <div>
                <div class="login-brand-name">@T["Marque"]</div>
                <div class="login-brand-org">@T["ConnexionDev"]</div>
            </div>
        </div>
        @if (_disponible is null)
        {
            <p role="status">@T["Chargement"]</p>
        }
        else if (_disponible == false)
        {
            <p role="alert">@T["ConnexionIndisponible"]</p>
        }
        else
        {
            <div class="login-header">
                <h1>@T["SeConnecter"]</h1>
                <p>@T["ConnexionAide"]</p>
            </div>
            @if (Erreur is not null)
            {
                <div class="login-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> @T["MatriculeInconnu"]
                </div>
            }
            @* Formulaire classique : le cookie est posé par la réponse de navigation, puis le serveur redirige vers l'accueil. *@
            <form class="login-form" method="post" action="bff/login">
                <div class="form-group">
                    <label for="matricule">@T["Matricule"]</label>
                    <input id="matricule" name="matricule" class="form-input" autocomplete="username" required autofocus />
                </div>
                <button type="submit" class="login-btn">@T["Connexion"]</button>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Erreur { get; set; }

    private bool? _disponible;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _disponible = await Bff.LoginDevDisponibleAsync();
        }
        catch (Exception e) when (e is ApiException or HttpRequestException)
        {
            _disponible = false;
        }
    }
}
