@using Gprojet.Front.Pages
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layouts.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layouts.MainLayout)">
            <Introuvable />
        </LayoutView>
    </NotFound>
</Router>
