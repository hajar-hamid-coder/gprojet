@inject IStringLocalizer<Textes> T
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layouts.MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>@T["PageIntrouvable"]</PageTitle>
        <p role="alert">@T["PageIntrouvableTexte"]</p>
    </NotFound>
</Router>
