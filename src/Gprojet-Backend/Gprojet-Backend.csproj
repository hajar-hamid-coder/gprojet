<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Gprojet.Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Aligne Relational sur EF Core 10.0.13 (Npgsql 10.0.3 n'exige que 10.0.4) : évite le conflit MSB3277 dans les tests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Données de référence des migrations : embarquées dans l'assembly (aucune lecture de fichier à l'exécution). -->
    <EmbeddedResource Include="Repositories\Migrations\Sql\*.sql" LogicalName="Migrations.Sql.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gprojet-Backend.Tests" />
  </ItemGroup>

</Project>
